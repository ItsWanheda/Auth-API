# Application
APP_NAME=AuthAPI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/authapi
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/authapi
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Cookies
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Email
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=AuthAPI
FRONTEND_URL=http://localhost:3000